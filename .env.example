# Copy this file to ".env.local" and fill in the values.

# From Supabase: Project Settings -> API Keys (see SUPABASE_SETUP.md).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Deposits (see DEPOSITS_SETUP.md). These are SECRET: server only.
SUPABASE_SECRET_KEY=sb_secret_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Waitlist emails (see WAITLIST_SETUP.md). SECRET: server only.
RESEND_API_KEY=re_...
# Until you own a domain: GZ Stylist App <onboarding@resend.dev>
EMAIL_FROM=GZ Stylist App <bookings@yourdomain.com>
CRON_SECRET=a-long-random-password

# Waitlist texts, once Twilio is approved. Leave TEXT_MESSAGES out until then.
# TEXT_MESSAGES=on
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+15551234567
